NODE_ENV=development
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
PUBLIC_WEB_BASE=https://dev.padbol.com

# Supabase. Usar exclusivamente el proyecto de desarrollo/QA en local.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Cifrado y tareas protegidas. Generar valores propios para desarrollo.
IDENTIDAD_ENCRYPTION_KEY=
RESERVAS_HOLD_CLEANUP_SECRET=

# Pagos. Usar claves de prueba.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MP_ACCESS_TOKEN=

# WhatsApp/Twilio. Dejar vacío si no se prueba mensajería.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# IA. Dejar AI_PROVIDER vacío si la prueba no usa el asistente.
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Controles operativos seguros para desarrollo local.
RATE_LIMIT_DISABLED=false
RATE_LIMIT_TRUST_PROXY=false
MATCH_ATTENDANCE_CONFIRMATION_ENABLED=false
MATCH_ATTENDANCE_CRON_ENABLED=false
MATCH_ATTENDANCE_REMINDERS_ENABLED=false
PADCOINS_ALERTAS_PUSH_ENABLED=false
PADCOINS_ALERTAS_WHATSAPP_ENABLED=false
PADCOINS_CANJES_EXPIRY_CRON_ENABLED=false
