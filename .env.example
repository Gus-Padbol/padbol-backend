# Copiar a .env en padbol-backend/

# Supabase — usar el custom domain (no el *.supabase.co del proyecto)
SUPABASE_URL=https://auth.padbolmatch.com
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Expo Push access token (recomendado cuando el proyecto habilita push security).
# Nunca exponerlo al frontend ni a la app nativa.
EXPO_ACCESS_TOKEN=

# WhatsApp Cloud API — comenzar únicamente con el número de prueba de Meta.
# El envío queda apagado salvo opt-in explícito del backend local.
WHATSAPP_META_APP_SECRET=
WHATSAPP_META_VERIFY_TOKEN=
WHATSAPP_META_GRAPH_VERSION=
WHATSAPP_META_TOKEN_TEST=
WHATSAPP_CLOUD_SEND_ENABLED=false
# Secreto compartido del webhook canónico de correo entrante (proveedor-agnóstico).
CRM_INBOUND_EMAIL_SECRET=
# Lectura entrante de info@padbol.com desde DonWeb/Hostmar. No habilita envíos.
CRM_INBOUND_IMAP_ENABLED=false
CRM_INBOUND_IMAP_HOST=
CRM_INBOUND_IMAP_PORT=993
CRM_INBOUND_IMAP_SECURE=true
CRM_INBOUND_IMAP_USER=info@padbol.com
CRM_INBOUND_IMAP_PASSWORD=
CRM_INBOUND_IMAP_MAILBOX=INBOX
CRM_INBOUND_IMAP_EXPECTED_RECIPIENT=info@padbol.com
CRM_INBOUND_IMAP_INTERVAL_MS=300000
CRM_INBOUND_IMAP_LOOKBACK_DAYS=7
CRM_INBOUND_IMAP_MAX_MESSAGES=100
CRM_INBOUND_IMAP_MAX_MESSAGE_BYTES=5242880
CRM_INBOUND_IMAP_MAX_SYNC_BYTES=20971520
# Una única llamada física por mensaje en el primer circuito sandbox.
# Si Meta responde de forma incierta, queda cancelado para revisión, sin reenvío.
WHATSAPP_CLOUD_MAX_SEND_ATTEMPTS=1

# Mercado Pago — token de producción APP_USR-… (La Meca / cuenta del club en sedes.mp_access_token)
# MERCADOPAGO_ACCESS_TOKEN=
# MP_ACCESS_TOKEN=  # alias legacy

# CORS, pagos, etc. (ver server.js y documentación de despliegue)
# CORS_ORIGIN=https://padbolmatch.com,https://www.padbolmatch.com
