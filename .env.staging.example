# Fill only with keys belonging to the independent staging project.
NODE_ENV=production
PORT=3001
BACKEND_RUNTIME_MODE=staging
RATE_LIMIT_TRUST_PROXY=true
MERCADOPAGO_WEBHOOK_SECRET=
RATE_LIMIT_LICENSE_REQUESTS_WINDOW_MS=900000
RATE_LIMIT_LICENSE_REQUESTS_MAX=8
RATE_LIMIT_MP_WEBHOOK_WINDOW_MS=60000
RATE_LIMIT_MP_WEBHOOK_MAX=120
STAGING_SUPABASE_PROJECT_REF=
PRODUCTION_SUPABASE_PROJECT_REF=vpldffhsxhgnmitiikof
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
BACKGROUND_JOBS_ENABLED=false
OUTBOUND_DELIVERY_ENABLED=false
PUSH_SEND_ENABLED=false
WHATSAPP_CLOUD_SEND_ENABLED=false
WHATSAPP_QA_SANDBOX_SEND_ENABLED=false
WHATSAPP_ASSISTANT_DISPATCH_ALLOWED=false
WHATSAPP_CLOUD_SEND_MAX_ATTEMPTS=1
# Set fresh staging-only verification secret and Meta app secret securely.
WHATSAPP_META_VERIFY_TOKEN=
WHATSAPP_META_APP_SECRET=
CRM_INBOUND_EMAIL_SECRET=
# Minify config/crm-whatsapp-funnel.qa.json and store the resulting single line in Render QA.
CRM_WHATSAPP_FUNNEL_PATHS_JSON=
# Leave DATABASE_URL and Stripe/Twilio/Resend/Anthropic/MercadoPago credentials unset.
FRONTEND_URL=
PADBOL_MATCH_WEB_URL=
# CORS_ORIGINS accepts the approved staging frontend origin.
CORS_ORIGINS=

# Optional until configured; /ready stays 503 while legacy SQL-dependent routes cannot run.
# QA only: postgres.<STAGING_REF>@<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Or postgres@db.<STAGING_REF>.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=
